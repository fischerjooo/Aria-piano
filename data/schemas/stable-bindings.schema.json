{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "courseLength": {
      "type": "integer",
      "minimum": 1
    },
    "lessonIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "melodyIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "gameIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "levelIds": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "levelLabels": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schemaVersion",
    "courseLength",
    "lessonIds",
    "melodyIds",
    "gameIds",
    "levelIds",
    "levelLabels"
  ],
  "additionalProperties": false
}
