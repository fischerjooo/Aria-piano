{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "provenance": {
      "type": "object",
      "properties": {
        "archive": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "status": {
          "const": "historical-generated-content-preserved"
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "archive",
        "sha256",
        "status",
        "note"
      ],
      "additionalProperties": false
    },
    "records": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "nav": {
            "type": "string",
            "minLength": 1
          },
          "sub": {
            "type": "string",
            "minLength": 1
          },
          "time": {
            "type": "string",
            "minLength": 1
          },
          "hand": {
            "type": "string",
            "minLength": 1
          },
          "instruction": {
            "type": "string",
            "minLength": 1
          },
          "fingering": {
            "type": "string",
            "minLength": 1
          },
          "tip": {
            "type": "string",
            "minLength": 1
          },
          "composer": {
            "type": "string",
            "minLength": 1
          },
          "difficulty": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "arrangement": {
            "type": "string",
            "minLength": 1
          },
          "rhythmLabel": {
            "type": "string",
            "minLength": 1
          },
          "focus": {
            "type": "string",
            "minLength": 1
          },
          "concept": {
            "type": "string",
            "minLength": 1
          },
          "curriculumCredit": {
            "type": "string",
            "minLength": 1
          },
          "curriculumUnit": {
            "type": "string",
            "minLength": 1
          },
          "slug": {
            "type": "string",
            "minLength": 1
          },
          "levelName": {
            "type": "string",
            "minLength": 1
          },
          "original": {
            "type": "boolean"
          },
          "rhythmReady": {
            "type": "boolean"
          },
          "accidentals": {
            "type": "boolean"
          },
          "application": {
            "type": "boolean"
          },
          "flats": {
            "type": "boolean"
          },
          "courseIndex": {
            "type": "integer",
            "minimum": 0
          },
          "level": {
            "type": "integer",
            "minimum": 0
          },
          "required": {
            "type": "integer",
            "minimum": 0
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "learningSteps": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "selfCheck": {
            "type": "string"
          },
          "transferTask": {
            "type": "string"
          },
          "normalBpm": {
            "type": "number",
            "minimum": 4,
            "maximum": 1000
          },
          "kind": {
            "enum": [
              "lesson",
              "melody"
            ]
          },
          "category": {
            "enum": [
              "classical",
              "games",
              "pop",
              "memes"
            ]
          },
          "articulation": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "sub",
          "time",
          "hand",
          "instruction",
          "fingering",
          "tip",
          "kind"
        ],
        "additionalProperties": false
      },
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      }
    }
  },
  "required": [
    "schemaVersion",
    "provenance",
    "records"
  ],
  "additionalProperties": false
}
