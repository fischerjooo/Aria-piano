{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "scores"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "scores": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "id",
          "composer",
          "arranger",
          "sourceUrl",
          "license",
          "licenseUrl",
          "scope",
          "instrumentation",
          "parts",
          "ranges",
          "sourceAttribution"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "composer": {
            "type": "string",
            "minLength": 1
          },
          "arranger": {
            "type": "string",
            "minLength": 1
          },
          "sourceUrl": {
            "type": "string",
            "minLength": 1
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "licenseUrl": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "instrumentation": {
            "type": "string",
            "minLength": 1
          },
          "parts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "ranges": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "prefixItems": [
                {
                  "type": "string"
                },
                {
                  "type": "string"
                },
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "integer",
                  "minimum": 1
                }
              ]
            }
          },
          "sourceAttribution": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
